{
  "name": "leggenda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import:world": "tsx scripts/import-world.ts",
    "lab": "tsx scripts/lab.ts",
    "check": "npm run typecheck && npm run test",
    "lab:choices": "tsx scripts/choices-lab.ts",
    "lab:vivaio": "tsx scripts/vivaio-check.ts",
    "racconto": "tsx scripts/racconto.ts",
    "verify": "npm run check && npm run build && npm run check:bundle && npm run lab -- --careers=2000 --seed=42 && npm run lab:choices -- --careers=100 && npm run lab:vivaio -- 4",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "build:map": "tsx scripts/build-map.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
