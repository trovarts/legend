{
  "name": "leggenda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import:world": "tsx scripts/import-world.ts",
    "lab": "tsx scripts/lab.ts",
    "check": "npm run typecheck && npm run test",
    "lab:choices": "tsx scripts/choices-lab.ts",
    "verify": "npm run check && npm run lab -- --careers=2000 --seed=42 && npm run lab:choices -- --careers=100"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
